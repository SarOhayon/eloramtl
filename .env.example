# Copy to .env.local (and add the same variables in Vercel > Settings > Environment Variables).

# Mapbox public token (starts with pk.). Without it the map uses CARTO's free tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional: Mapbox style, e.g. mapbox/light-v11 (default), or your own owner/style-id from Mapbox Studio.
NEXT_PUBLIC_MAPBOX_STYLE=

# Office hours from your Google Business Profile (server-side only, never sent to the browser).
# Without these, the site shows Monday to Friday, 8 am to 5 pm (src/lib/officeHours.ts).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
