# Copy to .env.local (and add the same variables in Vercel > Settings > Environment Variables).

# Mapbox public token (starts with pk.). Without it the map uses CARTO's free tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional: Mapbox style, e.g. mapbox/light-v11 (default), or your own owner/style-id from Mapbox Studio.
NEXT_PUBLIC_MAPBOX_STYLE=

# Office hours from your Google Business Profile (server-side only, never sent to the browser).
# Without these, the site shows Monday to Friday, 8 am to 5 pm (src/lib/officeHours.ts).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Website forms are emailed through your GreenGeeks mailbox (SMTP).
# Find these in GreenGeeks cPanel > Email Accounts > Connect Devices.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=website@eloramtl.com
SMTP_PASS=
# Optional: send forms somewhere other than sarah@eloramtl.com
MAIL_TO=

# Maintenance approvals: requests and photos wait in a private S3 bucket until approved.
# (Amplify doesn't allow variables starting with AWS_, hence ELORA_S3_.)
ELORA_S3_BUCKET=
ELORA_S3_REGION=us-east-2
ELORA_S3_ACCESS_KEY_ID=
ELORA_S3_SECRET_ACCESS_KEY=
# Any long random string; signs the Approve / Decline links.
APPROVAL_SECRET=
# Public address used in approval links, e.g. https://www.eloramtl.com (optional)
SITE_URL=

# WhatsApp maintenance bot (Meta WhatsApp Business Platform / Cloud API).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any phrase; enter the same one in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Boss's WhatsApp for approvals (digits with country code), and optional approval template.
APPROVER_WHATSAPP=
WHATSAPP_APPROVAL_TEMPLATE=
WHATSAPP_APPROVAL_TEMPLATE_LANG=en

# Admin (/admin, linked by the small dot at the end of the footer). Temporary single password.
ADMIN_PASSWORD=

# AI unit suggestions in the admin's Inquiries (Claude API key from console.anthropic.com).
ANTHROPIC_API_KEY=

# Optional: lets an outside scheduler call /api/cron?key=... hourly so follow-up emails and the
# Monday summary go out on time even when nobody visits the site. Any long random string.
CRON_SECRET=
